# Telegram
BOT_TOKEN=
ADMIN_IDS=
MAIN_CHANNEL_ID=-1003231515720
REELS_CHANNEL_ID=
REQUIRED_CHANNEL_IDS=

# PostgreSQL and Redis
# Docker Compose overrides these values with its internal service URLs.
# Local Windows PostgreSQL: use a localhost URL in your private .env file.
# Railway: paste the PostgreSQL URL supplied by Railway into DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cinestream
DATABASE_URL=
REDIS_URL=

# AI / AIMLAPI — multiple keys are failover only, not 3x quota
AIMLAPI_KEYS=
AIMLAPI_KEY_1=
AIMLAPI_KEY_2=
AIMLAPI_KEY_3=
AIMLAPI_KEY_4=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_MODEL=glm-5.2
AIMLAPI_FALLBACK_MODEL=
AIMLAPI_TIMEOUT=90
AIMLAPI_KEY_COOLDOWN_SECONDS=120

# Video tools
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_WORK_DIR=/app/data/work
WHISPER_MODEL=base
REEL_JOB_MAX_ATTEMPTS=3
REEL_MAX_PER_MOVIE=4
REEL_MIN_SECONDS=15
REEL_MAX_SECONDS=30
REEL_FACE_TRACKING=false
FACE_DETECTION_MODEL=haar
REEL_MOMENT_STRATEGY=auto
REEL_TRANSCRIPT_MAX_DURATION=1200
# Window-based moment selection (Clip Generator / Adversitas style)
REEL_WINDOW_SECONDS=300
REEL_WINDOW_MIN_DURATION=15
REEL_WINDOW_MAX_DURATION=30
REEL_WINDOW_MAX_RETRIES=3
REEL_USE_WINDOWS_THRESHOLD=300
WORKER_CONCURRENCY=1
WORKER_RETRY_BACKOFF_SECONDS=5
WORKER_RETRY_BACKOFF_MAX_SECONDS=300

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional HTTP health server (Railway sets PORT automatically)
HEALTH_PORT=
PORT=

# Manual Premium payment details (never commit real values)
PREMIUM_CARD_NUMBER=
PREMIUM_CARD_NAME=
PREMIUM_WEEKLY_PRICE=10000
PREMIUM_MONTHLY_PRICE=15000
ADMIN_CONTACT_USERNAME=

# Railway payment and advertising settings
CARD_NUMBER=9860 0601 2345 6789
CARD_OWNER=JOHN DOE
PREMIUM_WEEK_PRICE=10000
PREMIUM_MONTH_PRICE=15000
SUBSCRIBER_100_PRICE=15000
SUBSCRIBER_500_PRICE=70000
SUBSCRIBER_1000_PRICE=130000
