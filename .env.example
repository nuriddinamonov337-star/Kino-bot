# Advertising system (§12) — paid ad campaigns posted to a dedicated channel
REKLAMA_KANAL_ID=-1001234567890
REKLAMA_WEEK_PRICE=30000
REKLAMA_MONTH_PRICE=100000
REKLAMA_WEEK_TIMES_PER_DAY=3
REKLAMA_MONTH_TIMES_PER_DAY=5
# Daily posting hours (server local time), comma-separated
REKLAMA_POST_HOURS_3=9,15,21
REKLAMA_POST_HOURS_5=9,12,15,18,21

# Mandatory-channel subscriber-growth packages (§13)
MANDATORY_100_PRICE=15000
MANDATORY_500_PRICE=70000
MANDATORY_1000_PRICE=100000



